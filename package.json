{
  "name": "micropuffer",
  "version": "0.1.0",
  "description": "In-memory turbopuffer-compatible query engine for local tests and mocks.",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "main": "./pkg/micropuffer.js",
  "types": "./pkg/micropuffer.d.ts",
  "exports": {
    ".": {
      "types": "./pkg/micropuffer.d.ts",
      "import": "./pkg/micropuffer.js"
    }
  },
  "files": [
    "pkg/",
    "README.md"
  ],
  "scripts": {
    "build:wasm": "just wasm",
    "prepack": "just wasm",
    "test": "just check",
    "test:fuzz": "just test-fuzz",
    "test:live": "just test-live"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/JasonLovesDoggo/micropuffer.git"
  },
  "keywords": [
    "turbopuffer",
    "vector-search",
    "wasm",
    "mock",
    "testing"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "dotenv": "^17.4.2",
    "fast-check": "^4.8.0",
    "typescript": "^6.0.3",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  }
}
